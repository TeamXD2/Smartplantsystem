PORT=5000

# Supabase Dashboard -> Connect -> "Session pooler" connection string
# (replace [YOUR-PASSWORD] with your database password)
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Recommended: verify the database's TLS certificate. Supabase Dashboard ->
# Database -> Settings -> SSL Configuration -> Download certificate, save it
# in this folder and point to it. Left empty, the connection is encrypted but
# the certificate is NOT verified (a warning is printed at startup).
# DB_SSL_CA=./prod-ca-2021.crt

# Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=paste-the-service_role-key-here
SUPABASE_PHOTO_BUCKET=plant-photos
# Private bucket for the untouched original photos (never make it public).
SUPABASE_ORIGINAL_BUCKET=plant-photos-original

# Login protection (optional, these are the defaults). After LOGIN_FAILS_PER_IP wrong passwords for an
# email from one IP address, or LOGIN_FAILS_PER_ACCOUNT from anywhere, logins for that email are refused
# until the failures are LOGIN_LOCK_MINUTES old.
# LOGIN_FAILS_PER_IP=5
# LOGIN_FAILS_PER_ACCOUNT=20
# LOGIN_LOCK_MINUTES=15

# At least 32 random characters. A shorter one prints a warning, and in production the server refuses to start.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string_of_at_least_32_chars
# How long a login lasts. Short on purpose; changing or resetting a password also ends
# every older login at once.
JWT_EXPIRES_IN=12h

# Web app addresses allowed to call this API from a browser, comma-separated.
# Add the deployed web app's address here when it goes online.
# (The mobile app is not a browser, so it is not affected by this setting.)
# The web app keeps its login in an httpOnly cookie, so open the web app and the backend with the
# same host name (both on localhost), and list the web app's exact address here.
CORS_ORIGINS=http://localhost:5173

# The web app's login cookie (optional). strict = the cookie is only sent between pages of the same
# site, which is right while the web app and the backend both run on localhost. Use lax or none only if
# you must; none (web app on another site than the backend) needs HTTPS and always sets Secure.
# The cookie is Secure automatically in production; COOKIE_SECURE=true forces it.
# COOKIE_SAMESITE=strict
# COOKIE_SECURE=true

# Only when the backend runs behind a reverse proxy / hosting platform:
# how many proxies are in front of it (usually 1). Keeps the rate limits per visitor.
# TRUST_PROXY=1

# Protects the one-time "create the first administrator" page. Optional on your own
# computer; REQUIRED when NODE_ENV=production (the page stays closed without it).
# SETUP_KEY=choose-a-long-random-value

# ---- IoT (Sprint 2) ----
# Each ESP32 board has its OWN key, created by an Admin (POST /api/iot/sensors, or
# .../rotate-key for an existing board) and shown once. It goes into that board's sketch as
# the X-Device-Key header. Nothing about the keys is configured here, and the old shared
# IOT_DEVICE_KEY is no longer used.
# Alert limits (optional): alert when temperature is above, or humidity / soil moisture is below, these
IOT_TEMP_MAX=35
IOT_HUMIDITY_MIN=40
IOT_SOIL_MIN=20
