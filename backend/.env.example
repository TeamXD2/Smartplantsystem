PORT=5000

# Supabase Dashboard -> Connect -> "Session pooler" connection string
# (replace [YOUR-PASSWORD] with your database password)
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=paste-the-service_role-key-here
SUPABASE_PHOTO_BUCKET=plant-photos

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
