VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# From your Supabase project's Connect dialog, or Settings > API Keys.
# Supabase is retiring the old "anon" (eyJ...) key in favor of this
# "publishable" (sb_publishable_...) key - either works with the code here,
# but publishable is what new projects show you by default.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
